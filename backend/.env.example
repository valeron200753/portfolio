cd ~/Projects/ful
# =================================
# Application environment
# =================================

NODE_ENV=production

# Port for Express
PORT=3001

# =================================
# CSRF protection
# =================================

# Replace with your real HTTPS frontend origin.
# No trailing slash.
FRONTEND_ORIGINS=https://portfolio.example

# =================================
# SQLite database
# =================================

# Absolute path on persistent storage
TASKS_DB_PATH=/var/lib/portfolio/tasks.db

# =================================
# Backups
# =================================

# Backup storage directory
BACKUP_DIR=/var/backups/portfolio
lstack-30-days/portfolio/backend

nano .env.example
